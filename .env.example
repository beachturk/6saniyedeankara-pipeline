# Yerel test için (scripts/run.py) — bu dosyayı .env olarak kopyalayıp doldurun.
# GitHub Actions'ta bunlar yerine "GitHub Secrets" kullanılır (bkz. README.md).

# --- Metin üretimi (LLM) — sadece birini doldurmanız yeterli, config.yaml'da hangisi seçiliyse o kullanılır ---
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Proje: ankara ---
IG_ACCESS_TOKEN_ANKARA=
IG_BUSINESS_ID_ANKARA=

# --- Yeni bir proje eklerseniz (örn. "izmir") ---
# IG_ACCESS_TOKEN_IZMIR=
# IG_BUSINESS_ID_IZMIR=

# GitHub Actions içinde otomatik dolar, yerel testte repo bilgisini simüle etmek için:
GITHUB_REPOSITORY=kullanici-adi/repo-adi
GITHUB_REF_NAME=main
